{
  "name": "brains-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:web": "npm --prefix web run dev",
    "build:web": "npm --prefix web run build",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx --conditions=react-server --env-file=.env.local scripts/seed.ts",
    "backfill:profiles": "tsx --conditions=react-server --env-file=.env.local scripts/backfill-profiles.ts",
    "typecheck": "tsc --noEmit",
    "db:migrate": "drizzle-kit migrate",
    "smoke": "tsx --conditions=react-server --env-file=.env.local scripts/smoke-pipeline.ts",
    "smoke:stripe": "tsx --conditions=react-server --env-file=.env.local scripts/smoke-stripe.ts",
    "smoke:questions": "tsx --conditions=react-server --env-file=.env.local scripts/smoke-questionnaire.ts",
    "smoke:offer": "tsx scripts/smoke-offer.ts",
    "smoke:links": "tsx --conditions=react-server --env-file=.env.local scripts/smoke-links.ts",
    "smoke:limits": "tsx scripts/smoke-limits.ts",
    "smoke:sources": "tsx scripts/smoke-sources.ts",
    "smoke:visibility": "tsx scripts/smoke-visibility.ts",
    "smoke:pricing": "tsx --conditions=react-server --env-file=.env.local scripts/smoke-pricing-copy.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@clerk/nextjs": "^7.6.1",
    "@neondatabase/serverless": "^1.1.0",
    "@phosphor-icons/react": "^2.1.10",
    "@stripe/react-stripe-js": "^6.8.0",
    "@stripe/stripe-js": "^9.12.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "groq-sdk": "^1.4.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "next": "16.2.12",
    "pdf-parse": "^2.4.5",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "stripe": "^22.3.2",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  }
}
