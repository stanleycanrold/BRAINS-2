# ─────────────────────────────────────────────────────────────────────────────
# BRAINS AI — environment template. Copy to .env.local and fill in.
# ─────────────────────────────────────────────────────────────────────────────

# --- Auth (Clerk) --- https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# --- Database (Neon Postgres) --- https://console.neon.tech
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# --- LLM provider ---
# "gemini" is the default; "groq" and "anthropic" remain supported fallbacks.
LLM_PROVIDER=gemini
GROQ_API_KEY=gsk_xxx
# Must be a model that supports strict json_schema decoding.
GROQ_MODEL=openai/gpt-oss-120b
GROQ_SEARCH_MODEL=groq/compound-mini

# --- Search provider ---
# "gemini" uses Gemini + Google Search grounding; Groq is the automatic fallback.
SEARCH_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_SEARCH_MODEL=gemini-3.6-flash

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Payments (Stripe) ---
# Leave blank to run Fast Track checkout in simulated-payment mode.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Manual payment contact ---
# Founders email this address for payment instructions. Defaults to Stanley.
# Fast Track remains pending until you manually confirm payment.
PAYMENT_CONTACT_EMAIL=
RESEND_API_KEY=
# Required: a verified sender in Resend, e.g. BRAINS AI <hello@nexabrains.io>.
EMAIL_FROM=
WISE_PAYMENT_URL=

# --- App ---
NEXT_PUBLIC_APP_URL=https://nexabrains.io
OPS_ALLOWED_EMAILS=