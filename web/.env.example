# Where the product itself lives. Optional: a production build already
# defaults to https://app.nexabrains.io, and only `next dev` falls back to
# localhost. Set this to point a preview or staging deploy somewhere else.
NEXT_PUBLIC_APP_URL=http://localhost:3001

# This site's own public origin, used for canonical URLs, the sitemap, and
# Open Graph tags. Same rule: production defaults to https://nexabrains.io.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
