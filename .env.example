# ─────────────────────────────────────────────────────────────────────────────
# BRAINS AI — environment template. Copy to .env.local and fill in.
# ─────────────────────────────────────────────────────────────────────────────

# --- Auth (Clerk) --- https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# --- Database (Neon Postgres) --- https://console.neon.tech
DATABASE_URL=


# --- LLM provider — plug & play (just change LLM_PROVIDER + MODEL, no code) ---
# groq | gemini | openrouter | anthropic — all use same structured() interface
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_xxx
GROQ_MODEL=openai/gpt-oss-120b
GROQ_SEARCH_MODEL=groq/compound-mini
GEMINI_API_KEY= # AI Studio keys only (AIza... from https://aistudio.google.com/apikey) — supports comma-list for rotation
GEMINI_MODEL=gemini-1.5-flash
GEMINI_SEARCH_MODEL=gemini-1.5-flash
OPENROUTER_API_KEY= # sk-or-v1... — any OpenRouter model via OPENROUTER_MODEL
OPENROUTER_MODEL=openai/gpt-4o-mini

# --- Search provider — plug & play -----------------------------------------
# groq | gemini | openrouter — same search() interface, just change SEARCH_PROVIDER
SEARCH_PROVIDER=groq

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Payments (Stripe) ---
# Leave blank to run Fast Track checkout in simulated-payment mode.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Manual payment contact ---
# Founders email this address for payment instructions. Defaults to Stanley.
# Fast Track remains pending until you manually confirm payment.
PAYMENT_CONTACT_EMAIL=
RESEND_API_KEY=
# Required: a verified sender in Resend, e.g. BRAINS AI <hello@nexabrains.io>.
EMAIL_FROM=
WISE_PAYMENT_URL=

# --- App ---
# Root app = product (app.brains.im). The marketing site (brains.im) is the
# separate `web/` app and talks to this app cross-origin via these URLs.
NEXT_PUBLIC_APP_URL=https://app.brains.im
NEXT_PUBLIC_SITE_URL=https://brains.im
OPS_ALLOWED_EMAILS=
