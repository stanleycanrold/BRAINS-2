# Where the product itself lives. In production this is https://app.nexabrains.io
# (moving to https://app.brains-ai.com later). Defaults to the app's local dev
# port when unset, so both projects work together out of the box in dev.
NEXT_PUBLIC_APP_URL=http://localhost:3001

# The marketing site's own public origin. Used for canonical URLs, sitemap,
# and Open Graph tags. In production this is https://nexabrains.io.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
